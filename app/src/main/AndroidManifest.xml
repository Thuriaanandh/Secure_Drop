<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@null"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SecureDrop">

        <!-- Splash Screen (Launcher) -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.OnboardingActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.BiometricLockActivity"
            android:exported="false" />

        <!-- Main Dashboard -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false" />

        <!-- Upload & Share Flow -->
        <activity
            android:name=".ui.file.UploadFileActivity"
            android:exported="false" />

        <activity
            android:name=".ui.file.ShareSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.file.ShareCreatedActivity"
            android:exported="false" />

        <!-- Vault & Files -->
        <activity
            android:name=".ui.file.MyFilesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.file.FileDetailsActivity"
            android:exported="false" />

        <!-- Receive & Download Pipeline -->
        <activity
            android:name=".ui.receive.IncomingFileActivity"
            android:exported="false" />

        <activity
            android:name=".ui.receive.DownloadVerificationActivity"
            android:exported="false" />

        <!-- Audit Logs -->
        <activity
            android:name=".ui.audit.AccessLogsActivity"
            android:exported="false" />

        <!-- Security Center -->
        <activity
            android:name=".ui.security.SecurityCenterActivity"
            android:exported="false" />

        <!-- Settings -->
        <activity
            android:name=".ui.security.SettingsActivity"
            android:exported="false" />

        <!-- Security Demonstration Console (Debug Only) -->
        <activity
            android:name=".ui.security.SecurityDemoActivity"
            android:exported="false" />

    </application>
</manifest>
