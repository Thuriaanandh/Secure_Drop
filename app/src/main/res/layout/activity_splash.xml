<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Glowing Brand Logo Icon Container -->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_badge_blue"
            android:padding="20dp">

            <ImageView
                android:id="@+id/ivSplashLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/desc_app_logo"
                android:src="@drawable/ic_shield_check"
                app:tint="@color/brand_accent" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.12"
            android:text="SECUREDROP"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.04"
            android:text="Private files. Controlled access."
            android:textColor="@color/brand_accent"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/pbSplash"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="36dp"
            android:indeterminateTint="@color/brand_accent" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="28dp"
        android:letterSpacing="0.06"
        android:text="AES-256-GCM • ANDROID KEYSTORE PROTECTED"
        android:textColor="@color/text_muted"
        android:textSize="10sp"
        android:textStyle="bold" />
</RelativeLayout>
