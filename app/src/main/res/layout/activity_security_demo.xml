<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Velune Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_icon_button"
            android:contentDescription="Navigate Back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/brand_accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="Security Verification"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="INTERACTIVE CRYPTOGRAPHIC TEST SUITE"
                android:textColor="@color/brand_accent"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Test Item 1: Encryption -->
            <include
                android:id="@+id/cardTestEncryption"
                layout="@layout/item_security_test" />

            <!-- Test Item 2: Integrity -->
            <include
                android:id="@+id/cardTestIntegrity"
                layout="@layout/item_security_test" />

            <!-- Test Item 3: Expiring Link -->
            <include
                android:id="@+id/cardTestExpiringLink"
                layout="@layout/item_security_test" />

            <!-- Test Item 4: One-Time Download -->
            <include
                android:id="@+id/cardTestOneTime"
                layout="@layout/item_security_test" />

            <!-- Test Item 5: Revocation -->
            <include
                android:id="@+id/cardTestRevocation"
                layout="@layout/item_security_test" />

            <!-- Test Item 6: Screenshot Protection -->
            <include
                android:id="@+id/cardTestScreenshot"
                layout="@layout/item_security_test" />

            <!-- Test Item 7: Biometric Auth -->
            <include
                android:id="@+id/cardTestBiometric"
                layout="@layout/item_security_test" />

            <!-- Test Item 8: IDOR / Unauthorized Access -->
            <include
                android:id="@+id/cardTestIdor"
                layout="@layout/item_security_test" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
